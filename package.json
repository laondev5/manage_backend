{
  "name": "manage-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "db:dev": "tsx src/scripts/dev-db.ts",
    "db:verify": "tsx src/scripts/verify-indexes.ts",
    "db:indexes:apply": "tsx src/scripts/apply-indexes.ts",
    "seed": "tsx src/scripts/seed.ts",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "security:check": "node scripts/security-check.mjs",
    "test": "vitest run --exclude **/*.integration.test.ts",
    "test:integration": "vitest run src/__tests__/integration",
    "dev:worker": "tsx watch src/worker/index.ts",
    "start:worker": "node dist/worker.js",
    "db:indexes:verify": "tsx src/scripts/verify-indexes.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.25",
    "better-auth": "1.7.25",
    "cors": "2.8.6",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "mongodb": "7.9.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "resend": "6.38.1",
    "sanitize-html": "^2.18.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "7.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.2",
    "tslib": "2.8.1",
    "tsup": "8.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.20.0",
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": true
    }
  },
  "engines": {
    "node": ">=22 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "mongodb-memory-server",
      "sharp",
      "unrs-resolver",
      "@tailwindcss/oxide",
      "lightningcss"
    ]
  }
}
