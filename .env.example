# Manage environment configuration.
# Copy this file to .env for local development. Never commit real secrets.

# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Better Auth needs an explicit HTTPS URL in production.
AUTH_BASE_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API with cookies.
TRUSTED_WEB_ORIGINS=http://localhost:3000
# Custom URL scheme used by the Expo app.
MOBILE_SCHEME=manage
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Only enable behind a trusted reverse proxy.
TRUST_PROXY=false

# --- MongoDB (replica set required for transactions) ---
MONGODB_URI=mongodb://127.0.0.1:27017/manage?replicaSet=rs0
MONGODB_DB_NAME=manage
# Keep the pool small on serverless; every warm instance holds its own pool.
MONGODB_MAX_POOL_SIZE=10

# --- Email ---
# Without RESEND_API_KEY the API and worker use a disk-based local adapter and say so.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Manage <alerts@manage.local>
LOCAL_NOTIFICATION_DIR=.data/notifications

# --- Push ---
# Without EXPO_ACCESS_TOKEN the worker writes push payloads to disk.
EXPO_ACCESS_TOKEN=

# --- Attendance and delivery policy ---
PRESENCE_STALE_SECONDS=300
STALE_SHIFT_HOURS=16
LOCATION_RETENTION_DAYS=7
OUTBOX_MAX_ATTEMPTS=8
WORKER_LEASE_SECONDS=60
WORKER_POLL_MS=3000
WORKER_RECONCILE_SECONDS=45

# --- Scheduled worker ---
# GitHub Actions (.github/workflows/worker-tick.yml) calls
# POST /api/v1/internal/worker/tick with WORKER_TRIGGER_SECRET as the bearer
# token. Either CRON_SECRET or WORKER_TRIGGER_SECRET must be set in production
# (32+ chars); CRON_SECRET is only read by Vercel Cron, which this repo does not
# configure.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_TRIGGER_SECRET=
CRON_SECRET=
# How often the scheduler invokes the endpoint. Keep this aligned with the
# workflow cron (300 = every five minutes) so the admin health page does not
# report the worker as overdue.
WORKER_SCHEDULE_SECONDS=300

# --- Development only ---
# Returns invitation tokens in API responses outside production.
ENABLE_DEV_TOKENS=false
SEED_PASSWORD=ManageDemo!2026
